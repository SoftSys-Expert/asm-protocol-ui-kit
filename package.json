{
  "name": "@asm-protocol/ui-kit",
  "version": "0.1.0",
  "description": "UI kit for ASM Protocol educational portal — Histoire stories with operator and tty skins",
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "histoire dev",
    "build": "vite build",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "preview": "vite preview",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:stylelint",
    "lint:eslint": "eslint \"src/**/*.{js,ts}\"",
    "lint:prettier": "prettier --check \"src/**/*.{js,ts,css}\"",
    "lint:stylelint": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{js,ts,css}\"",
    "lint:fix": "npm run lint:eslint -- --fix && npm run lint:stylelint -- --fix && npm run format",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "histoire": "^1.0.0-beta.1",
    "prettier": "^3.4.2",
    "stylelint": "^16.14.1",
    "stylelint-config-standard": "^37.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.0"
  },
  "keywords": [
    "ui-kit",
    "asm-protocol",
    "histoire",
    "stories",
    "cyberpunk-terminal"
  ],
  "author": "Konstantin Khlopkov <kokhlo>",
  "license": "MIT"
}
